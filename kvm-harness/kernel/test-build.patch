+static bool spte_test_and_clear_young(u64 *sptep)
+{
+	u64 spte = *sptep;
+
+	if (!is_shadow_present_pte(spte) || !spte_ad_enabled(spte) ||
+	    !is_accessed_spte(spte))
+		return false;
+
+	clear_bit((ffs(shadow_accessed_mask) - 1), (unsigned long *)sptep);
+	return true;
