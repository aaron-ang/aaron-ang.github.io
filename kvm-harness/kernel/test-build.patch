+/* Drop a leaf SPTE of a zapped page, passing its Accessed bit to the host page. */
+static void lru_drop_spte_keep_accessed(struct kvm *kvm, u64 *sptep)
+{
+	u64 old_spte = mmu_spte_clear_track_bits(kvm, sptep);
+	struct page *page;
+	kvm_pfn_t pfn;
+
+	if (!is_shadow_present_pte(old_spte))
+		return;
+	rmap_remove(kvm, sptep);
+
+	if (!is_accessed_spte(old_spte))
+		return;
+	pfn = spte_to_pfn(old_spte);
+	if (!pfn_valid(pfn))
+		return;
+	page = pfn_to_page(pfn);
+	if (PageReserved(page))
+		return;
+
+	if (lru_zap_accessed == LRU_ZAP_ACC_YOUNG)
+		folio_set_young(page_folio(page));
+	else
+		mark_page_accessed(page);
+	kvm->stat.lru_zap_marks++;
+}
